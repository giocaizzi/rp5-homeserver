{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Single-origin OAuth + MCP reverse-proxy. One codebase, deployed once per upstream
	// (one Worker per upstream MCP server) via wrangler environments.
	//
	// Each env gets its own workers.dev hostname, its own KV namespace, and its
	// own secrets. ${DOMAIN}, ${ALLOWED_EMAILS} and ${KV_ID_<ENV>} are placeholders,
	// rendered at deploy time from secrets on the cloudflare-workers GitHub environment
	// by render-config.sh (deploy-workers.yml, deploy.sh). Never deploy this file unrendered.
	"name": "mcp-connector",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-01",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	// No top-level deploy target — always deploy with --env <service>.
	"env": {
		"greenhouse": {
			"name": "mcp-connector-greenhouse",
			"vars": {
				"SERVICE_NAME": "Greenhouse",
				"UPSTREAM_URL": "https://greenhouse.${DOMAIN}/mcp",
				"ALLOWED_EMAILS": "${ALLOWED_EMAILS}"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "${KV_ID_GREENHOUSE}"
				}
			]
		},
		"firefly": {
			"name": "mcp-connector-firefly",
			"vars": {
				"SERVICE_NAME": "Firefly III",
				"UPSTREAM_URL": "https://firefly.${DOMAIN}/api/v1/mcp",
				"ALLOWED_EMAILS": "${ALLOWED_EMAILS}"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "${KV_ID_FIREFLY}"
				}
			]
		},
		"n8n": {
			"name": "mcp-connector-n8n",
			"vars": {
				"SERVICE_NAME": "n8n",
				"UPSTREAM_URL": "https://n8n.${DOMAIN}/mcp-server/http",
				"ALLOWED_EMAILS": "${ALLOWED_EMAILS}"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "${KV_ID_N8N}"
				}
			]
		},
		"grafana": {
			"name": "mcp-connector-grafana",
			"vars": {
				"SERVICE_NAME": "Grafana",
				"UPSTREAM_URL": "https://grafana.${DOMAIN}/mcp",
				"ALLOWED_EMAILS": "${ALLOWED_EMAILS}"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "${KV_ID_GRAFANA}"
				}
			]
		},
		"netdata": {
			"name": "mcp-connector-netdata",
			"vars": {
				"SERVICE_NAME": "Netdata",
				"UPSTREAM_URL": "https://netdata-mcp.${DOMAIN}/mcp",
				"ALLOWED_EMAILS": "${ALLOWED_EMAILS}"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "${KV_ID_NETDATA}"
				}
			]
		},
		"portainer": {
			"name": "mcp-connector-portainer",
			"vars": {
				"SERVICE_NAME": "Portainer",
				"UPSTREAM_URL": "https://portainer.${DOMAIN}/mcp",
				"ALLOWED_EMAILS": "${ALLOWED_EMAILS}"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "${KV_ID_PORTAINER}"
				}
			]
		},
		"langfuse": {
			"name": "mcp-connector-langfuse",
			"vars": {
				"SERVICE_NAME": "Langfuse",
				"UPSTREAM_URL": "https://langfuse-mcp.${DOMAIN}/api/public/mcp",
				"UPSTREAM_AUTH_SCHEME": "Basic",
				"ALLOWED_EMAILS": "${ALLOWED_EMAILS}"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "${KV_ID_LANGFUSE}"
				}
			]
		}
	}
}