{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Single-origin OAuth + MCP reverse-proxy. One codebase, deployed once per upstream
	// (one Worker per upstream MCP server) via wrangler environments.
	//
	// Each env gets its own workers.dev hostname, its own KV namespace, and its
	// own secrets. Fill the KV `id`s after `wrangler kv namespace create` (see README).
	"name": "mcp-connector",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-01",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	// No top-level deploy target — always deploy with --env <service>.
	"env": {
		"greenhouse": {
			"name": "mcp-connector-greenhouse",
			"vars": {
				"SERVICE_NAME": "Greenhouse",
				"UPSTREAM_URL": "https://greenhouse.giocaizzi.xyz/mcp",
				"ALLOWED_EMAILS": "giocaizzi@gmail.com"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "07a2c01840b44f96966e2691dbac4d9e"
				}
			]
		},
		"firefly": {
			"name": "mcp-connector-firefly",
			"vars": {
				"SERVICE_NAME": "Firefly III",
				"UPSTREAM_URL": "https://firefly.giocaizzi.xyz/api/v1/mcp",
				"ALLOWED_EMAILS": "giocaizzi@gmail.com"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "90e16176346a472d8375b4c310868f40"
				}
			]
		},
		"n8n": {
			"name": "mcp-connector-n8n",
			"vars": {
				"SERVICE_NAME": "n8n",
				"UPSTREAM_URL": "https://n8n.giocaizzi.xyz/mcp-server/http",
				"ALLOWED_EMAILS": "giocaizzi@gmail.com"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "20c5002a26414d7d94cace25ddbf637a"
				}
			]
		},
		"grafana": {
			"name": "mcp-connector-grafana",
			"vars": {
				"SERVICE_NAME": "Grafana",
				"UPSTREAM_URL": "https://grafana.giocaizzi.xyz/mcp",
				"ALLOWED_EMAILS": "giocaizzi@gmail.com"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "e840096a5eaf4a29b50281f26839a0ac"
				}
			]
		},
		"netdata": {
			"name": "mcp-connector-netdata",
			"vars": {
				"SERVICE_NAME": "Netdata",
				"UPSTREAM_URL": "https://netdata-mcp.giocaizzi.xyz/mcp",
				"ALLOWED_EMAILS": "giocaizzi@gmail.com"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "625257f9839343d9b9108984608afe18"
				}
			]
		},
		"portainer": {
			"name": "mcp-connector-portainer",
			"vars": {
				"SERVICE_NAME": "Portainer",
				"UPSTREAM_URL": "https://portainer.giocaizzi.xyz/mcp",
				"ALLOWED_EMAILS": "giocaizzi@gmail.com"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "25a0d84ba6b24637bb081fec7618ee25"
				}
			]
		},
		"langfuse": {
			"name": "mcp-connector-langfuse",
			"vars": {
				"SERVICE_NAME": "Langfuse",
				"UPSTREAM_URL": "https://langfuse-mcp.giocaizzi.xyz/api/public/mcp",
				"UPSTREAM_AUTH_SCHEME": "Basic",
				"ALLOWED_EMAILS": "giocaizzi@gmail.com"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "455059d989a441d88fe2e1556d6ea435"
				}
			]
		}
	}
}