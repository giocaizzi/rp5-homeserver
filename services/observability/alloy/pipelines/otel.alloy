// =============================================================================
// OTEL PIPELINE MODULE
// =============================================================================
// Receives telemetry via OTLP (HTTP/gRPC), guards collector memory, batches,
// applies resource-level defaults, then fans out by signal to the appropriate
// backend.
//
// Data Flow:
//   OTLP Receivers → memory_limiter → batch → transform (defaults) →
//                                                ├─ metrics → Prometheus
//                                                ├─ traces  → Tempo (OTLP gRPC)
//                                                └─ logs    → Loki (OTLP HTTP)
//
// Why memory_limiter first:
//   Limits are Go heap (not RSS), sized to the 768M container: hard 640MiB,
//   soft 512MiB (hard - spike 128MiB). GOMEMLIMIT=480MiB (compose) makes Go
//   GC before the soft limit, so the limiter only refuses data
//   (retryable) on real spikes. Alloy's baseline heap is ~200-290MiB
//   (docker log tailing + scrapes).
//
// Loki ingest:
//   Logs go to Loki's native OTLP endpoint (/otlp) via otelcol.exporter.otlphttp.
//   Label promotion (which OTEL attributes become Loki stream labels) is
//   configured server-side in Loki's `limits_config.otlp_config`, not via the
//   legacy "loki.resource.labels" / "loki.attribute.labels" hint attributes.
//   This keeps hint metadata off Prometheus series and Tempo spans without
//   needing a log-only attributes processor.
//
// Resource defaults:
//   `otelcol.processor.transform` with `context = "resource"` fills missing
//   resource attributes for external clients. `where ... == nil` preserves
//   any value the client already sent. `service.namespace` is intentionally
//   NOT defaulted — senders own it; if a payload arrives without one the
//   attribute stays empty and is queryable as such downstream.
//
// host.name datapoint promotion:
//   The Prometheus exporter puts resource attributes only into `target_info`,
//   not as labels on each series — so `host_name` is inconsistent across
//   `claude_code_*` metrics (some counters carry none). A `context = "datapoint"`
//   metric_statements block copies resource `host.name` onto each datapoint so
//   it surfaces as a uniform `host_name` label, queryable without joining to
//   `target_info`. Only `host.name` is promoted; `service.version` / `os.version`
//   are deliberately left on the resource to avoid per-release counter churn.
//
// Auth:
//   HTTP (port 4318) requires `Authorization: Bearer <token>`. Same enforcement
//   applies to LAN traffic (otel.home) and public traffic (otel.<domain>
//   behind CF Access bypass) — the bearer is validated by Alloy regardless of
//   source.
//   gRPC (port 4317) is unauthenticated; the port is bound to the
//   observability overlay only (no host publish, no nginx route) so it is
//   reachable solely from other containers on the same Swarm overlay.
//
// Arguments:
//   prometheus_receiver - Prometheus remote_write endpoint receiver
//
// Backends:
//   Metrics → Prometheus remote_write (via argument)
//   Logs    → Loki OTLP HTTP (hardcoded endpoint)
//   Traces  → Tempo OTLP gRPC (hardcoded endpoint)
// =============================================================================

declare "otlp_receivers" {
  // ---------------------------------------------------------------------------
  // ARGUMENTS
  // ---------------------------------------------------------------------------
  argument "prometheus_receiver" {
    comment = "Prometheus remote_write endpoint receiver"
  }

  // ---------------------------------------------------------------------------
  // BEARER AUTH (HTTP receiver only)
  // ---------------------------------------------------------------------------
  // Reads the shared secret from the Swarm-mounted file and exposes a handler
  // for the OTLP HTTP receiver. `is_secret = true` keeps the value out of
  // Alloy's debug UI / exported metrics.

  local.file "otel_bearer_token" {
    filename  = "/run/secrets/alloy_otel_bearer_token"
    is_secret = true
  }

  otelcol.auth.bearer "otlp_http" {
    token = local.file.otel_bearer_token.content
  }

  // ---------------------------------------------------------------------------
  // OTLP RECEIVERS
  // ---------------------------------------------------------------------------
  // HTTP: port 4318 (bearer-auth required), gRPC: port 4317 (overlay-only)

  otelcol.receiver.otlp "default" {
    grpc {
      endpoint = "0.0.0.0:4317"
    }
    http {
      endpoint = "0.0.0.0:4318"
      auth     = otelcol.auth.bearer.otlp_http.handler
    }

    output {
      metrics = [otelcol.processor.memory_limiter.default.input]
      logs    = [otelcol.processor.memory_limiter.default.input]
      traces  = [otelcol.processor.memory_limiter.default.input]
    }
  }

  // ---------------------------------------------------------------------------
  // MEMORY LIMITER
  // ---------------------------------------------------------------------------
  // Backpressure guard sized for the Pi. Sits before batch so spikes can be
  // shed before they accumulate in the batch buffer.

  otelcol.processor.memory_limiter "default" {
    check_interval = "1s"
    limit          = "640MiB"
    spike_limit    = "128MiB"

    output {
      metrics = [otelcol.processor.batch.default.input]
      logs    = [otelcol.processor.batch.default.input]
      traces  = [otelcol.processor.batch.default.input]
    }
  }

  // ---------------------------------------------------------------------------
  // BATCH PROCESSOR
  // ---------------------------------------------------------------------------
  // Batches telemetry data before export for efficiency

  otelcol.processor.batch "default" {
    timeout         = "10s"
    send_batch_size = 1000

    output {
      metrics = [otelcol.processor.transform.defaults.input]
      logs    = [otelcol.processor.transform.defaults.input]
      traces  = [otelcol.processor.transform.defaults.input]
    }
  }

  // ---------------------------------------------------------------------------
  // RESOURCE-LEVEL DEFAULTS
  // ---------------------------------------------------------------------------
  // Fills missing resource attributes for external OTLP clients that don't
  // set them. Uses otelcol.processor.transform with `context = "resource"` so
  // statements run against resource attributes (not data-point attributes).
  // The `where ... == nil` guard preserves any value the client already sent.
  //
  // `service.namespace` is intentionally absent — senders own this attribute.

  otelcol.processor.transform "defaults" {
    error_mode = "ignore"

    metric_statements {
      context = "resource"
      statements = [
        `set(resource.attributes["service.name"], "codex") where resource.attributes["service.name"] != nil and IsMatch(resource.attributes["service.name"], "^codex")`,
        `set(resource.attributes["deployment.environment.name"], "production") where resource.attributes["deployment.environment.name"] == nil`,
        `set(resource.attributes["source"], "otel") where resource.attributes["source"] == nil`,
        `set(resource.attributes["tier"], "core") where resource.attributes["tier"] == nil`,
      ]
    }

    // Promote resource host.name onto each datapoint so the Prometheus exporter
    // emits a uniform `host_name` label on every series (it otherwise lands only
    // in `target_info`). Guarded to never overwrite an existing value or set nil.
    // Only host.name — promoting service.version/os.version would churn counters.
    metric_statements {
      context = "datapoint"
      statements = [
        `set(attributes["host.name"], resource.attributes["host.name"]) where attributes["host.name"] == nil and resource.attributes["host.name"] != nil`,
      ]
    }

    // No `source` default on logs: Loki flattens resource and record attributes
    // into one structured-metadata map, and a resource `source=otel` replaced
    // the record's own `source` (Claude Code's tool_decision source: config,
    // hook, user_temporary, ...). OTLP logs are told apart by service_name.
    log_statements {
      context = "resource"
      statements = [
        `set(resource.attributes["service.name"], "codex") where resource.attributes["service.name"] != nil and IsMatch(resource.attributes["service.name"], "^codex")`,
        `set(resource.attributes["deployment.environment.name"], "production") where resource.attributes["deployment.environment.name"] == nil`,
        `set(resource.attributes["tier"], "core") where resource.attributes["tier"] == nil`,
      ]
    }

    trace_statements {
      context = "resource"
      statements = [
        `set(resource.attributes["service.name"], "codex") where resource.attributes["service.name"] != nil and IsMatch(resource.attributes["service.name"], "^codex")`,
        `set(resource.attributes["deployment.environment.name"], "production") where resource.attributes["deployment.environment.name"] == nil`,
        `set(resource.attributes["source"], "otel") where resource.attributes["source"] == nil`,
        `set(resource.attributes["tier"], "core") where resource.attributes["tier"] == nil`,
      ]
    }

    output {
      metrics = [otelcol.exporter.prometheus.default.input]
      logs    = [otelcol.processor.transform.agent_usage.input]
      traces  = [otelcol.exporter.otlp.tempo.input, otelcol.processor.filter.copilot_spans.input]
    }
  }

  // ---------------------------------------------------------------------------
  // AGENT USAGE (one request schema across coding harnesses)
  // ---------------------------------------------------------------------------
  // Every model request of every harness becomes a log record with
  // agent.event="api_request" and the same fields: model, session_id,
  // input_tokens (uncached), cache_read_tokens, output_tokens, cost_usd.
  // The Agents dashboards (grafana/.../dashboards/agents) query only these.
  //   claude-code:  api_request already carries them (cost_usd from Claude Code).
  //   opencode, pi: the harness guard plugin sends api_request with its own cost.
  //   codex:        codex.sse_event response.completed has tokens, no cost
  //                 (input_token_count includes cached): PRICE TABLE below.
  //   github-copilot, copilot-chat: chat spans, turned into logs below; cost
  //                 from github.copilot.nano_aiu where present (1e9 nano AIU =
  //                 1 AI credit = $0.01), else the PRICE TABLE.
  // Update the price table when prices or the harnesses' default models change
  // (docs/monitoring.md, Agent cost). A model with no row has no cost.

  otelcol.processor.transform "agent_usage" {
    error_mode = "ignore"

    log_statements {
      context = "log"
      statements = [
        `set(attributes["agent.event"], "api_request") where attributes["event.name"] == "api_request" and (resource.attributes["service.name"] == "claude-code" or resource.attributes["service.name"] == "opencode" or resource.attributes["service.name"] == "pi")`,
        `set(attributes["agent.event"], "api_request") where resource.attributes["service.name"] == "codex" and attributes["event.name"] == "codex.sse_event" and attributes["event.kind"] == "response.completed" and attributes["input_token_count"] != nil`,
        `set(attributes["session_id"], attributes["conversation.id"]) where attributes["agent.event"] == "api_request" and resource.attributes["service.name"] == "codex"`,
        `set(attributes["cache_read_tokens"], Int(attributes["cached_token_count"])) where attributes["agent.event"] == "api_request" and resource.attributes["service.name"] == "codex"`,
        `set(attributes["input_tokens"], Int(attributes["input_token_count"]) - Int(attributes["cached_token_count"])) where attributes["agent.event"] == "api_request" and resource.attributes["service.name"] == "codex"`,
        `set(attributes["output_tokens"], Int(attributes["output_token_count"])) where attributes["agent.event"] == "api_request" and resource.attributes["service.name"] == "codex"`,
        // PRICE TABLE: USD per 1M tokens of input, cache read, output, at list prices
        // checked 2026-10-17 (docs/monitoring.md, Agent cost, lists the sources).
        // Applies only where the harness reported no cost of its own. The first
        // matching row wins, so a long-context row (prompt = input + cache read over
        // the threshold) precedes its model's default row, and a specific model
        // precedes a broader regex. Copilot bills Claude and GPT at the API's rates;
        // only GPT-5.6 Luna's long-context threshold differs (200K on Copilot).
        // Claude (platform.claude.com pricing); versions match with dots or dashes.
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 10.0 + Double(attributes["cache_read_tokens"]) * 0.25 + Double(attributes["output_tokens"]) * 50.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-fable-5[-.]1")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 10.0 + Double(attributes["cache_read_tokens"]) * 1.0 + Double(attributes["output_tokens"]) * 50.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-fable-5")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 4.0 + Double(attributes["cache_read_tokens"]) * 0.2 + Double(attributes["output_tokens"]) * 20.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-opus-5[-.]5")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 10.0 + Double(attributes["cache_read_tokens"]) * 1.0 + Double(attributes["output_tokens"]) * 50.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-opus-4[-.]8.*fast")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 5.0 + Double(attributes["cache_read_tokens"]) * 0.5 + Double(attributes["output_tokens"]) * 25.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-opus-(5|4[-.][5-8])")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 2.0 + Double(attributes["cache_read_tokens"]) * 0.1 + Double(attributes["output_tokens"]) * 10.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-sonnet-5[-.]5")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 2.0 + Double(attributes["cache_read_tokens"]) * 0.2 + Double(attributes["output_tokens"]) * 10.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-sonnet-5")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 3.0 + Double(attributes["cache_read_tokens"]) * 0.3 + Double(attributes["output_tokens"]) * 15.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-sonnet-4")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.5 + Double(attributes["cache_read_tokens"]) * 0.05 + Double(attributes["output_tokens"]) * 2.5) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-haiku-5[-.]5") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 100000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.1 + Double(attributes["cache_read_tokens"]) * 0.01 + Double(attributes["output_tokens"]) * 0.5) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-haiku-5[-.]5")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 1.0 + Double(attributes["cache_read_tokens"]) * 0.1 + Double(attributes["output_tokens"]) * 5.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^claude-haiku-4[-.]5")`,
        // OpenAI (developers.openai.com pricing, Standard; long context over 272K).
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 4.0 + Double(attributes["cache_read_tokens"]) * 0.2 + Double(attributes["output_tokens"]) * 15.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-6\\.1-sol") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 2.0 + Double(attributes["cache_read_tokens"]) * 0.1 + Double(attributes["output_tokens"]) * 10.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-6\\.1-sol")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 4.0 + Double(attributes["cache_read_tokens"]) * 0.4 + Double(attributes["output_tokens"]) * 15.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-6-sol") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 2.0 + Double(attributes["cache_read_tokens"]) * 0.2 + Double(attributes["output_tokens"]) * 10.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-6-sol")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.2 + Double(attributes["cache_read_tokens"]) * 0.02 + Double(attributes["output_tokens"]) * 0.75) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-6-luna") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.1 + Double(attributes["cache_read_tokens"]) * 0.01 + Double(attributes["output_tokens"]) * 0.5) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-6-luna")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 20.0 + Double(attributes["cache_read_tokens"]) * 2.0 + Double(attributes["output_tokens"]) * 75.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-6-astra") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 10.0 + Double(attributes["cache_read_tokens"]) * 1.0 + Double(attributes["output_tokens"]) * 50.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-6-astra")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 8.0 + Double(attributes["cache_read_tokens"]) * 0.8 + Double(attributes["output_tokens"]) * 30.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.6-sol") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 4.0 + Double(attributes["cache_read_tokens"]) * 0.4 + Double(attributes["output_tokens"]) * 20.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.6-sol")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 4.0 + Double(attributes["cache_read_tokens"]) * 0.4 + Double(attributes["output_tokens"]) * 18.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.6-terra") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 2.0 + Double(attributes["cache_read_tokens"]) * 0.2 + Double(attributes["output_tokens"]) * 12.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.6-terra")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.4 + Double(attributes["cache_read_tokens"]) * 0.04 + Double(attributes["output_tokens"]) * 1.8) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.6-luna") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 200000 and (resource.attributes["service.name"] == "github-copilot" or resource.attributes["service.name"] == "copilot-chat")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.4 + Double(attributes["cache_read_tokens"]) * 0.04 + Double(attributes["output_tokens"]) * 1.8) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.6-luna") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000 and resource.attributes["service.name"] != "github-copilot" and resource.attributes["service.name"] != "copilot-chat"`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.2 + Double(attributes["cache_read_tokens"]) * 0.02 + Double(attributes["output_tokens"]) * 1.2) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.6-luna")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 10.0 + Double(attributes["cache_read_tokens"]) * 1.0 + Double(attributes["output_tokens"]) * 45.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.5(-20|$)") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 5.0 + Double(attributes["cache_read_tokens"]) * 0.5 + Double(attributes["output_tokens"]) * 30.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.5(-20|$)")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 5.0 + Double(attributes["cache_read_tokens"]) * 0.5 + Double(attributes["output_tokens"]) * 22.5) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.4(-20|$)") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 272000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 2.5 + Double(attributes["cache_read_tokens"]) * 0.25 + Double(attributes["output_tokens"]) * 15.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.4(-20|$)")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.75 + Double(attributes["cache_read_tokens"]) * 0.075 + Double(attributes["output_tokens"]) * 4.5) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.4-mini")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.2 + Double(attributes["cache_read_tokens"]) * 0.02 + Double(attributes["output_tokens"]) * 1.25) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.4-nano")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.25 + Double(attributes["cache_read_tokens"]) * 0.025 + Double(attributes["output_tokens"]) * 2.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5-mini")`,
        // Copilot-only models at Copilot's per-token rates (docs.github.com, Models
        // and pricing; 1 AI credit = $0.01): copilot-chat spans carry no nano_aiu.
        // Gemini rates are promotional, Argon until 2026-12-01, Flash until 2026-12-31.
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 1.75 + Double(attributes["cache_read_tokens"]) * 0.175 + Double(attributes["output_tokens"]) * 14.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gpt-5\\.3-codex")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.75 + Double(attributes["cache_read_tokens"]) * 0.075 + Double(attributes["output_tokens"]) * 3.75) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gemini-3\\.[78]-flash")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 2.0 + Double(attributes["cache_read_tokens"]) * 0.1 + Double(attributes["output_tokens"]) * 10.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^gemini-4-argon")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 4.0 + Double(attributes["cache_read_tokens"]) * 1.0 + Double(attributes["output_tokens"]) * 12.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^grok-4\\.[5-7]") and attributes["input_tokens"] + attributes["cache_read_tokens"] > 200000`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 2.0 + Double(attributes["cache_read_tokens"]) * 0.5 + Double(attributes["output_tokens"]) * 6.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^grok-4\\.[5-7]")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 3.0 + Double(attributes["cache_read_tokens"]) * 0.3 + Double(attributes["output_tokens"]) * 15.0) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^kimi-k3")`,
        `set(attributes["cost_usd"], (Double(attributes["input_tokens"]) * 0.2 + Double(attributes["cache_read_tokens"]) * 0.02 + Double(attributes["output_tokens"]) * 1.2) / 1000000.0) where attributes["agent.event"] == "api_request" and attributes["cost_usd"] == nil and IsMatch(attributes["model"], "^mai-code-1\\.1-flash")`,
      ]
    }

    output {
      logs = [otelcol.exporter.otlphttp.loki.input]
    }
  }

  // Copilot CLI and VS Code report tokens, cost and tools only on spans. Keep
  // their model calls (chat) and tool calls, turn each into a log record, then
  // map it onto the request schema above.
  otelcol.processor.filter "copilot_spans" {
    error_mode = "ignore"

    traces {
      span = [
        `not (resource.attributes["service.name"] == "github-copilot" or resource.attributes["service.name"] == "copilot-chat")`,
        `not (attributes["gen_ai.operation.name"] == "chat" or attributes["gen_ai.operation.name"] == "execute_tool")`,
      ]
    }

    output {
      traces = [otelcol.connector.spanlogs.copilot.input]
    }
  }

  otelcol.connector.spanlogs "copilot" {
    spans              = true
    span_attributes    = ["gen_ai.operation.name", "gen_ai.conversation.id", "gen_ai.response.model", "gen_ai.request.model", "gen_ai.usage.input_tokens", "gen_ai.usage.output_tokens", "gen_ai.usage.cache_read.input_tokens", "github.copilot.nano_aiu", "gen_ai.tool.name"]
    process_attributes = ["service.name", "host.name", "service.version"]
    // Only keys listed in labels become log attributes; the rest stay in the body.
    labels             = ["gen_ai.operation.name", "gen_ai.conversation.id", "gen_ai.response.model", "gen_ai.request.model", "gen_ai.usage.input_tokens", "gen_ai.usage.output_tokens", "gen_ai.usage.cache_read.input_tokens", "github.copilot.nano_aiu", "gen_ai.tool.name", "service.name", "host.name", "service.version"]

    output {
      logs = [otelcol.processor.transform.copilot_logs.input]
    }
  }

  otelcol.processor.transform "copilot_logs" {
    error_mode = "ignore"

    log_statements {
      context = "log"
      statements = [
        // spanlogs records carry no timestamp; Loki drops a zero time as too old.
        `set(time, Now())`,
        `set(resource.attributes["service.name"], attributes["service.name"])`,
        `set(resource.attributes["host.name"], attributes["host.name"]) where attributes["host.name"] != nil`,
        `set(resource.attributes["deployment.environment.name"], "production")`,
        `set(attributes["event.name"], Concat(["copilot", attributes["gen_ai.operation.name"]], "."))`,
        `set(attributes["session_id"], attributes["gen_ai.conversation.id"])`,
        `set(attributes["agent.event"], "api_request") where attributes["gen_ai.operation.name"] == "chat"`,
        `set(attributes["model"], attributes["gen_ai.response.model"]) where attributes["gen_ai.operation.name"] == "chat"`,
        `set(attributes["model"], attributes["gen_ai.request.model"]) where attributes["gen_ai.operation.name"] == "chat" and attributes["model"] == nil`,
        `set(attributes["cache_read_tokens"], Int(attributes["gen_ai.usage.cache_read.input_tokens"])) where attributes["gen_ai.operation.name"] == "chat"`,
        `set(attributes["cache_read_tokens"], 0) where attributes["gen_ai.operation.name"] == "chat" and attributes["cache_read_tokens"] == nil`,
        `set(attributes["input_tokens"], Int(attributes["gen_ai.usage.input_tokens"]) - attributes["cache_read_tokens"]) where attributes["gen_ai.operation.name"] == "chat"`,
        `set(attributes["output_tokens"], Int(attributes["gen_ai.usage.output_tokens"])) where attributes["gen_ai.operation.name"] == "chat"`,
        `set(attributes["cost_usd"], Double(attributes["github.copilot.nano_aiu"]) * 0.00000000001) where attributes["gen_ai.operation.name"] == "chat" and attributes["github.copilot.nano_aiu"] != nil`,
        `set(attributes["agent.event"], "tool_result") where attributes["gen_ai.operation.name"] == "execute_tool"`,
        `set(attributes["tool_name"], attributes["gen_ai.tool.name"]) where attributes["gen_ai.operation.name"] == "execute_tool"`,
      ]
    }

    output {
      logs = [otelcol.processor.transform.agent_usage.input]
    }
  }

  // ---------------------------------------------------------------------------
  // PROMETHEUS EXPORTER (Metrics)
  // ---------------------------------------------------------------------------
  // Forwards OTEL metrics to Prometheus remote_write

  otelcol.exporter.prometheus "default" {
    forward_to = argument.prometheus_receiver.value
  }

  // ---------------------------------------------------------------------------
  // LOKI EXPORTER (Logs) — native OTLP HTTP
  // ---------------------------------------------------------------------------
  // Forwards OTEL logs to Loki's /otlp endpoint. Label promotion is configured
  // in Loki's limits_config.otlp_config — no client-side hint attributes.

  otelcol.exporter.otlphttp "loki" {
    client {
      endpoint = "http://observability-log-store:3100/otlp"
      tls {
        insecure = true
      }
    }
  }

  // ---------------------------------------------------------------------------
  // TEMPO EXPORTER (Traces)
  // ---------------------------------------------------------------------------
  // Forwards traces to Tempo via OTLP gRPC

  otelcol.exporter.otlp "tempo" {
    client {
      endpoint = "observability-trace-store:4317"
      tls {
        insecure = true
      }
    }

    retry_on_failure {
      enabled          = true
      initial_interval = "5s"
      max_interval     = "30s"
      max_elapsed_time = "5m"
    }

    sending_queue {
      enabled       = true
      num_consumers = 2
      queue_size    = 500
    }
  }
}
