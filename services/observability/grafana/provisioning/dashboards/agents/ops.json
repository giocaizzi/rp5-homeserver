    {
      "id": 17,
      "type": "table",
      "title": "Subagent cost by agent role (all harnesses)",
      "description": "A spawn given a name (Agent tool `name`) carries no agent name in Claude Code telemetry and shows as (named spawn).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name, agent_name, model) (sum_over_time({service_name=~\"$harness\", host_name=~\"$host\"} | (event_name=\"api_request\" or agent_event=\"api_request\") | query_source=~\"agent:.*\" | label_format agent_name=`{{ if .agent_name }}{{ .agent_name }}{{ else }}(named spawn){{ end }}` | unwrap cost_usd | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
