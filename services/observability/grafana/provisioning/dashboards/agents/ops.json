{
  "uid": "agents-ops",
  "title": "Agent Ops",
  "description": "Guard decisions, skill use, tool failures and subagent routing across agent harnesses.",
  "tags": [
    "agents"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "harness",
        "label": "Harness",
        "type": "custom",
        "query": "claude-code,codex,github-copilot,copilot-chat,opencode,pi,antigravity",
        "includeAll": true,
        "multi": true,
        "allValue": "claude-code|codex.*|github-copilot|copilot-chat|opencode|pi|antigravity.*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "claude-code",
            "value": "claude-code"
          },
          {
            "selected": false,
            "text": "codex",
            "value": "codex"
          },
          {
            "selected": false,
            "text": "github-copilot",
            "value": "github-copilot"
          },
          {
            "selected": false,
            "text": "copilot-chat",
            "value": "copilot-chat"
          },
          {
            "selected": false,
            "text": "opencode",
            "value": "opencode"
          },
          {
            "selected": false,
            "text": "pi",
            "value": "pi"
          },
          {
            "selected": false,
            "text": "antigravity",
            "value": "antigravity"
          }
        ],
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({service_name=~\"claude-code|codex.*|github-copilot|copilot-chat|opencode|pi|guard|antigravity.*\"}, host_name)",
        "query": {
          "label": "host_name",
          "stream": "{service_name=~\"claude-code|codex.*|github-copilot|copilot-chat|opencode|pi|guard|antigravity.*\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
