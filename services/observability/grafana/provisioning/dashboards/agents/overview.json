    {
      "id": 7,
      "type": "stat",
      "title": "Cache read share",
      "description": "Ratio of cache read prompt tokens to total prompt tokens.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (sum_over_time({service_name=~\"$harness\", host_name=~\"$host\", deployment_environment_name!=\"test\"} | (agent_event=\"api_request\" or event_name=\"api_request\") and model=~\"$model\" | unwrap cache_read_tokens | __error__=\"\" [$__range])) / (sum (sum_over_time({service_name=~\"$harness\", host_name=~\"$host\", deployment_environment_name!=\"test\"} | (agent_event=\"api_request\" or event_name=\"api_request\") and model=~\"$model\" | unwrap cache_read_tokens | __error__=\"\" [$__range])) + sum (sum_over_time({service_name=~\"$harness\", host_name=~\"$host\", deployment_environment_name!=\"test\"} | (agent_event=\"api_request\" or event_name=\"api_request\") and model=~\"$model\" | unwrap input_tokens | __error__=\"\" [$__range])) + sum (sum_over_time({service_name=~\"$harness\", host_name=~\"$host\", deployment_environment_name!=\"test\"} | (agent_event=\"api_request\" or event_name=\"api_request\") and model=~\"$model\" | unwrap cache_creation_tokens | __error__=\"\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
