// supergateway servers: each is served at /<name>/mcp on port 8000.
// Every server needs its own apiKeyFile (a Swarm secret, see README); the
// gateway refuses to start if a key file is missing or empty.
{
  "port": 8000,
  "healthEndpoint": "/healthz",
  "logFormat": "json",
  // Defaults for every server: Streamable HTTP, one server process per session.
  "outputTransport": "streamableHttp",
  "stateful": true,
  "sessionTimeout": 900000,
  "mcpServers": {
    // Google Flights (PyPI `flights`). Shared upstream: no user data.
    "fli": {
      "command": "/opt/mcp/fli/bin/fli-mcp",
      "apiKeyFile": "/run/secrets/fli_api_key"
    },
    // Garmin Connect (Taxuspt/garmin_mcp). Owner only: personal data. Tokens
    // come from a one-time interactive `garmin-mcp-auth` (docs/mcp-stdio.md).
    "garmin": {
      "command": "/opt/mcp/garmin/bin/garmin-mcp",
      "apiKeyFile": "/run/secrets/garmin_api_key",
      "env": { "GARMINTOKENS": "/home/node/.garminconnect" }
    },
    // Surfline forecasts (giocaizzi/pysurfline, read-only tools). Anonymous
    // Surfline access: no user data.
    "surfline": {
      "command": "/opt/mcp/surfline/bin/surfline-mcp",
      "apiKeyFile": "/run/secrets/surfline_api_key",
      // FastMCP logs INFO to stderr, which the gateway reports as errors.
      "env": { "FASTMCP_LOG_LEVEL": "WARNING" }
    }
  }
}
